{
    "name": "tricoredb/tricoredb",
    "description": "Native PHP driver for TriCoreDB: SQL with server-side parameters, transactions, documents, cache, vectors, graphs and LLM context over the tricore wire protocol, with no runtime dependencies.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "tricoredb",
        "tricore",
        "database",
        "driver",
        "client",
        "sql",
        "document",
        "cache",
        "vector",
        "graph"
    ],
    "homepage": "https://github.com/trinesh14/tricoredb-sdk-php",
    "authors": [
        {
            "name": "Trinesh Kumar"
        }
    ],
    "support": {
        "issues": "https://github.com/trinesh14/tricoredb-sdk-php/issues",
        "source": "https://github.com/trinesh14/tricoredb-sdk-php",
        "docs": "https://github.com/trinesh14/tricoredb-sdk-php#readme"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-openssl": "Required for TLS connections (ssl:// streams)"
    },
    "autoload": {
        "psr-4": {
            "TriCoreDb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TriCoreDb\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    }
}
